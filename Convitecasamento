<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Paula e João – Convite de Casamento</title>
<style>
* { margin:0; padding:0; box-sizing:border-box; }
body { background:#1a1a1a; display:flex; justify-content:center; }

.page { width:100%; max-width:480px; position:relative; }
.page img { width:100%; display:block; }

#click-area {
  position: absolute;
  top: 38%; left: 35%;
  width: 30%; height: 12%;
  cursor: pointer;
  z-index: 20;
  border-radius: 50%;
}

#letter {
  position: absolute;
  left: 12%; width: 76%; top: 40%;
  opacity: 0;
  transform: translateY(0%);
  border-radius: 3px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  cursor: pointer;
  pointer-events: none;
  z-index: 15;
}

/* botão música */
#music-btn {
  position: fixed;
  bottom: 20px; right: 20px;
  z-index: 100;
  width: 44px; height: 44px;
  border-radius: 50%;
  background: rgba(45,90,61,0.88);
  border: 2px solid rgba(201,168,76,0.8);
  color: white;
  font-size: 18px;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 16px rgba(0,0,0,0.35);
  transition: transform 0.2s;
}
#music-btn:hover { transform: scale(1.1); }
#music-btn.playing { animation: musicPulse 2s ease-in-out infinite; }
@keyframes musicPulse {
  0%,100% { box-shadow: 0 4px 16px rgba(0,0,0,0.3), 0 0 0 0 rgba(201,168,76,0.5); }
  50%      { box-shadow: 0 4px 16px rgba(0,0,0,0.3), 0 0 0 10px rgba(201,168,76,0); }
}

/* brilhinhos */
.sparkle {
  position:absolute; pointer-events:none; z-index:30; border-radius:50%;
  animation: sparkleFly var(--dur) cubic-bezier(0.25,0.46,0.45,0.94) forwards; opacity:0;
}
@keyframes sparkleFly {
  0%   { transform:translate(0,0) scale(1); opacity:1; }
  60%  { opacity:1; }
  100% { transform:translate(var(--tx),var(--ty)) scale(0); opacity:0; }
}
.star {
  position:absolute; pointer-events:none; z-index:30; opacity:0;
  animation: starFly var(--dur) ease-out forwards;
}
@keyframes starFly {
  0%   { transform:translate(0,0) scale(0) rotate(0deg); opacity:1; }
  20%  { transform:translate(calc(var(--tx)*0.3),calc(var(--ty)*0.3)) scale(1.2) rotate(45deg); opacity:1; }
  100% { transform:translate(var(--tx),var(--ty)) scale(0) rotate(120deg); opacity:0; }
}

/* página 2 */
#page2 { display:none; width:100%; max-width:480px; position:relative; }
#page2 img { width:100%; display:block; }
#map-link {
  position:absolute; bottom:16.5%; left:14%; width:72%; height:5%;
  z-index:10; text-decoration:none;
}

@keyframes letterRise {
  0%   { opacity:0; transform:translateY(30%); }
  25%  { opacity:1; }
  100% { opacity:1; transform:translateY(-40%); }
}
@keyframes fadeIn { from{opacity:0} to{opacity:1} }
.running-letter { animation: letterRise 1.1s cubic-bezier(0.22,1,0.36,1) 0.2s forwards; }
.fadein { animation: fadeIn 0.8s ease forwards; }
</style>
</head>
<body>

<!-- áudio embutido -->
<audio id="audio" loop preload="auto">
  <source src="data:audio/mpeg;base64," type="audio/mpeg">
</audio>

<div class="page" id="page1">
  <img src="data:image/jpeg;base64," alt="Envelope">
  <img id="letter" src="data:image/jpeg;base64," alt="Convite" onclick="showPage2()">
  <div id="click-area" onclick="openEnvelope()"></div>
</div>

<div id="page2">
  <img src="data:image/jpeg;base64," alt="Convite Paula e João">
  <a id="map-link" href="https://www.google.com/maps/search/R.+Joaquim+Ribeiro+Porto,+1131"
     target="_blank" rel="noopener noreferrer"></a>
</div>

<button id="music-btn" onclick="toggleMusic()" title="Música">🎵</button>

<script>
const audio = document.getElementById('audio');
const btn   = document.getElementById('music-btn');
let musicPlaying = false;

function startMusic() {
  audio.volume = 0;
  audio.play().then(() => {
    musicPlaying = true;
    btn.textContent = '🔇';
    btn.classList.add('playing');
    // fade in suave
    let v = 0;
    const fade = setInterval(() => {
      v = Math.min(v + 0.03, 0.75);
      audio.volume = v;
      if (v >= 0.75) clearInterval(fade);
    }, 80);
  }).catch(() => {});
}

function stopMusic() {
  // fade out
  let v = audio.volume;
  const fade = setInterval(() => {
    v = Math.max(v - 0.04, 0);
    audio.volume = v;
    if (v <= 0) { clearInterval(fade); audio.pause(); }
  }, 60);
  musicPlaying = false;
  btn.textContent = '🎵';
  btn.classList.remove('playing');
}

function toggleMusic() {
  if (musicPlaying) stopMusic();
  else startMusic();
}

// brilhinhos
const colors = ['#c9a84c','#e8d48a','#ffffff','#f5e6a0','#2d5a3d','#ffd700','#fffacd'];
function createSparkles(ox, oy) {
  const page = document.getElementById('page1');
  for (let i = 0; i < 28; i++) {
    const isCircle = Math.random() > 0.45;
    const el = document.createElement('div');
    el.className = isCircle ? 'sparkle' : 'star';
    const angle = (360/28)*i + (Math.random()-0.5)*25;
    const dist  = 40 + Math.random()*90;
    const rad   = angle * Math.PI/180;
    const tx = Math.cos(rad)*dist, ty = Math.sin(rad)*dist;
    const size  = isCircle ? (3+Math.random()*7) : (6+Math.random()*10);
    const color = colors[Math.floor(Math.random()*colors.length)];
    el.style.cssText = `left:${ox}px;top:${oy}px;--tx:${tx}px;--ty:${ty}px;--dur:${(0.5+Math.random()*0.7)+'s'};animation-delay:${(Math.random()*0.15)+'s'};`;
    if (isCircle) {
      el.style.width=size+'px'; el.style.height=size+'px';
      el.style.background=color;
      el.style.marginLeft=(-size/2)+'px'; el.style.marginTop=(-size/2)+'px';
      el.style.boxShadow=`0 0 ${size*1.5}px ${color}`;
    } else {
      el.innerHTML=`<svg width="${size*2}" height="${size*2}" viewBox="0 0 20 20"><polygon points="10,0 12,8 20,10 12,12 10,20 8,12 0,10 8,8" fill="${color}" opacity="0.95"/></svg>`;
      el.style.marginLeft=(-size)+'px'; el.style.marginTop=(-size)+'px';
    }
    page.appendChild(el);
    setTimeout(() => el.remove(), 1500);
  }
}

let opened = false;
function openEnvelope() {
  if (opened) return;
  opened = true;

  startMusic();
  document.getElementById('click-area').style.display = 'none';

  const page = document.getElementById('page1');
  const cx = page.offsetWidth * 0.50;
  const cy = page.offsetHeight * 0.44;
  createSparkles(cx, cy);
  setTimeout(() => createSparkles(cx, cy), 250);
  setTimeout(() => createSparkles(cx, cy), 480);

  const letter = document.getElementById('letter');
  letter.classList.add('running-letter');
  setTimeout(() => { letter.style.pointerEvents = 'auto'; }, 1400);
}

function showPage2() {
  if (!opened) { openEnvelope(); return; }
  document.getElementById('page1').style.display = 'none';
  const p2 = document.getElementById('page2');
  p2.style.display = 'block';
  p2.classList.add('fadein');
}
</script>
</body>
</html>
